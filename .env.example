# Skopiuj do .env.local (lokalnie) lub ustaw w Vercel → Project → Settings → Environment Variables.
# NIGDY nie commituj prawdziwych wartości.

# Adres produkcyjny (metadane, Open Graph, sitemap)
SITE_URL=https://forma-remont.example.com

# Kanał(y) dostarczania formularza: telegram | webhook | email  (kilka: telegram,email)
FORM_DELIVERY=

# --- telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- webhook (np. Make, Zapier, n8n, własny backend) ---
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# --- email przez Resend (https://resend.com) ---
RESEND_API_KEY=
FORM_EMAIL_TO=
FORM_EMAIL_FROM=
